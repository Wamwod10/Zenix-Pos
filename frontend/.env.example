# Zenix POS frontend
# Local development: direct connection to the local Node.js API.
VITE_API_URL=http://localhost:4000

# Production on Vercel:
# Leave VITE_API_URL empty/unset so the browser uses the same-origin /api proxy.
# Configure this server-only Vercel environment variable instead:
ZENIX_BACKEND_URL=https://your-zenix-api.onrender.com
